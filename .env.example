# Frontend defaults to same-origin /ws through Vite or your reverse proxy.
# VITE_WS_URL=wss://your-room-host.example/ws
PORT=3001
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ROOM_CAPACITY=48
# Set a long random value only on the server to enable POST /admin/kick.
# ADMIN_TOKEN=
# Optional shared invitation (server only); leave blank for local demo.
# ROOM_INVITE=
# Names this room instance; parties and presence are scoped to it.
# ROOM_ID=courtyard

# Economic Simulation Lab authoritative store (server only). Preserve its data volume and backups.
# Never place this file in public/ or a frontend build directory; use one room-server writer.
# LAB_DATA_FILE=server/data/economic-lab.json

# ---- Opt-in gameplay statistics (see docs/ANALYTICS.md). Off unless enabled here AND by the player.
# ANALYTICS_ENABLED=1
# ANALYTICS_SALT=a-long-random-secret-at-least-16-characters
# ANALYTICS_DIR=server/data/analytics
# ANALYTICS_RETENTION_DAYS=90

# ---- Accounts, profiles, clubs and events (optional; see docs/ACCOUNTS.md) ----
# Leave these unset to run guest-only: the interface explains that accounts are not set up.
#
# Frontend build (PUBLIC values, compiled into the bundle). Row Level Security protects the data.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
#
# Room server only (never prefix with VITE_, never commit real values).
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---- Campus store (optional; see docs/STORE.md). Needs accounts. Room server only: never VITE_, never commit.
# BACHS_SECRET_KEY=sk_sandbox_...            (sk_live_... takes real payments)
# BACHS_WEBHOOK_SECRET=the-webhook-endpoint-signing-secret
# PUBLIC_APP_URL=https://worlds.example.edu  (players return to /shop-return.html here)
# Prices in whole naira; change and restart the room.
# SHOP_PRICE_CHARACTER=3000
# SHOP_PRICE_ITEM=1000
