{
  "mcpServers": {
    "threejs-devtools": {
      "command": "npx",
      "args": ["-y", "threejs-devtools-mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--headless", "--isolated"]
    },
    "blender": {
      "command": "uvx",
      "args": ["mcp-for-blender"],
      "env": { "BLENDER_MCP_DISABLE_TELEMETRY": "true" }
    }
  }
}
