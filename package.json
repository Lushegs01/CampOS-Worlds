{
  "name": "campos-worlds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,room \"vite --host 0.0.0.0\" \"node server/index.mjs\"",
    "dev:web": "vite --host 0.0.0.0",
    "server": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "dev:local": "node scripts/dev/local-stack.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@react-three/fiber": "9.8.1",
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "0.577.0",
    "n8ao": "^1.10.1",
    "postprocessing": "^6.39.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.183.2",
    "ws": "8.22.0",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "@playwright/test": "1.58.2",
    "@types/node": "24.19.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "5.1.4",
    "concurrently": "9.2.5",
    "embedded-postgres": "17.10.0-beta.17",
    "fbx2gltf": "^0.9.7-p1",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.0.1",
    "pg": "8.23.0",
    "rollup": "npm:@rollup/wasm-node@4.64.5",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.64.5"
  }
